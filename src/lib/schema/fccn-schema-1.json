{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schéma d'exercice",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "const": "fccn-schema:1",
      "description": "Version du document."
    },
    "settings": {
      "type": "array",
      "description": "Réglages traités par l'application. Une entrée, une clé.",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "Titre de l'exercice, ou nom d'une zone." },
          "units": { "enum": ["meters", "relative"], "description": "Unité des positions quand l'appel n'en donne pas." },
          "outline": { "type": "boolean", "description": "Relie les objets de la forme par un trait." },
          "width": { "type": "number", "description": "Largeur, en mètres." },
          "length": { "type": "number", "description": "Longueur, en mètres." },
          "margin": { "type": "number", "description": "Marge autour du terrain, en mètres." },
          "origin": {
            "type": "object",
            "description": "Point du terrain, en mètres, posé sur l'origine du document.",
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "boundary": { "type": "string", "description": "Élément posé aux quatre coins." },
          "fixed": { "type": "boolean", "description": "Le dessin se voit. Il ne se sélectionne pas et ne se déplace pas." },
          "fit": { "type": "string", "enum": ["none", "ratio", "free"], "description": "Étirement." },
          "listed": { "type": "boolean", "description": "Proposé dans le sélecteur d'ajout. Absent, il l'est." },
          "real-w": { "type": "number", "description": "Largeur réelle du viewBox, en mètres." },
          "real-h": { "type": "number", "description": "Hauteur réelle du viewBox, en mètres." },
          "min-size": { "description": "Minimum lisible, en part du grand côté. 1.6% ou 0." },
          "stretch-x": { "type": "string", "description": "Bandes horizontales." },
          "stretch-y": { "type": "string", "description": "Bandes verticales." },
          "upright": { "type": "array", "items": { "type": "string" }, "description": "Parties qui gardent l'horizontale." },
          "sizes": {
            "type": "object",
            "description": "Affichage des objets. scale multiplie les minimums.",
            "properties": { "scale": { "type": "number" } },
            "additionalProperties": { "description": "Minimum de cet élément." }
          },
          "viewBox": { "type": "string", "description": "ViewBox du dessin." },
          "trajectory": { "$ref": "#/definitions/trajectory" }
        }
      }
    },
    "define": {
      "type": "array",
      "description": "Parties nommées, en mètres. Le nom est libre. r, p ou c de l'appel choisit les champs lus.",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": { "$ref": "#/definitions/markPart" }
      }
    },
    "parameters": {
      "type": "array",
      "description": "Paramètres de l'élément et leur valeur par défaut. Une entrée, une clé.",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": { "type": ["string", "number"], "description": "Valeur par défaut." }
      }
    },
    "defaults": {
      "type": "array",
      "description": "Valeurs. Une clé param=valeur donne des valeurs quand le paramètre vaut cela. Une clé de type donne des arguments par défaut aux appels.",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "description": "Valeur. Un réglage peut être un booléen ou une liste de noms.",
            "oneOf": [
              { "type": ["string", "number", "boolean"] },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "description": "Joueurs, ballon, matériel, tracés et terrain. Une zone, une formation ou une forme s'écrit zone, formation ou shape, avec un seul appel.",
      "items": { "$ref": "#/definitions/objectItem" }
    },
    "phases": {
      "type": "array",
      "description": "Phases de l'animation, dans le repère du document.",
      "items": { "$ref": "#/definitions/phase" }
    }
  },
  "definitions": {
    "markPart": {
      "type": "object",
      "additionalProperties": false,
      "description": "Partie nommée. Un nombre absent vaut 0. r lit x, y, w et h. p et c lisent x et y.",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "radius": { "type": "number" }
      }
    },
    "trajectory": {
      "type": "object",
      "description": "Ligne médiane et motif d'une flèche.",
      "properties": {
        "motif": { "enum": ["none", "sine", "zigzag"] },
        "via": { "type": "array", "items": { "$ref": "#/definitions/markPoint" } },
        "wave": { "type": "number" },
        "amp": { "type": "number" },
        "phase": { "type": "number" },
        "side": { "enum": [1, -1] },
        "taper": { "type": "number" },
        "neck": { "type": "number" },
        "trim": { "type": "number" }
      }
    },
    "markPoint": {
      "type": "object",
      "description": "Position. Un nombre absent vaut 0.",
      "properties": {
        "x": { "type": "number", "description": "Abscisse." },
        "y": { "type": "number", "description": "Ordonnée." }
      }
    },
    "markSize": {
      "type": "object",
      "description": "Taille. Un nombre absent vaut 0.",
      "properties": {
        "w": { "type": "number", "description": "Largeur." },
        "h": { "type": "number", "description": "Hauteur." }
      }
    },
    "markRect": {
      "type": "object",
      "description": "Rectangle. Un nombre absent vaut 0.",
      "properties": {
        "x": { "type": "number", "description": "Abscisse." },
        "y": { "type": "number", "description": "Ordonnée." },
        "w": { "type": "number", "description": "Largeur." },
        "h": { "type": "number", "description": "Hauteur." }
      }
    },
    "markCircle": {
      "type": "object",
      "description": "Cercle. Un nombre absent vaut 0.",
      "properties": {
        "x": { "type": "number", "description": "Abscisse." },
        "y": { "type": "number", "description": "Ordonnée." },
        "radius": { "type": "number", "description": "Rayon." }
      }
    },
    "point": {
      "description": "Point.",
      "oneOf": [
        {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "description": "Abscisse." },
            "y": { "type": "number", "description": "Ordonnée." }
          }
        },
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "travel": {
      "description": "Trajet. Sans via, une ligne droite.",
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "description": "Abscisse d'arrivée." },
            "y": { "type": "number", "description": "Ordonnée d'arrivée." },
            "arrow": { "type": "string", "description": "Préréglage, par exemple zigzag. none dessine rien." },
            "via": {
              "type": "array",
              "description": "Points de passage, dans l'ordre.",
              "items": { "$ref": "#/definitions/point" }
            },
            "wave": { "type": "number", "description": "Longueur d'onde, en mètres." },
            "amp": { "type": "number", "description": "Amplitude, en mètres." },
            "phase": { "type": "number", "description": "Décalage de phase." },
            "side": { "enum": [1, -1], "description": "Côté du motif." },
            "taper": { "type": "number", "description": "Adoucissement, en mètres." },
            "neck": { "type": "number", "description": "Arrivée droite, en mètres." },
            "width": { "type": "number", "description": "Épaisseur, en mètres." },
            "dash": { "type": "string", "description": "Pointillés, ou none." },
            "ink": { "type": "string", "description": "Encre." }
          }
        }
      ]
    },
    "inset": {
      "description": "Quatre côtés, vertical puis horizontal, ou chaque côté.",
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "y": { "type": "number", "description": "Haut et bas." },
            "x": { "type": "number", "description": "Gauche et droite." },
            "top": { "type": "number", "description": "Haut." },
            "right": { "type": "number", "description": "Droite." },
            "bottom": { "type": "number", "description": "Bas." },
            "left": { "type": "number", "description": "Gauche." }
          }
        }
      ]
    },
    "call": {
      "description": "Arguments. Un nom seul équivaut à { name }. x, y, w et h sont à plat.",
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        {
          "type": "object",
          "properties": {
            "name": { "type": ["string", "number"], "description": "Nom, ou numéro du joueur." },
            "title": { "type": "string", "description": "Texte écrit dans le dessin, à la place de {{title}}." },
            "pitch": { "type": "string", "description": "Demi-terrain du document. Le rectangle vient de la zone de ce nom." },
            "fill": { "type": "string", "description": "Couleur du lavis." },
            "alpha": { "type": "number", "description": "Transparence du lavis, de 0 à 1." },
            "p": { "description": "Position. Un nombre absent vaut 0. Un texte nomme un point du terrain.", "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/markPoint" }] },
            "s": { "description": "Taille. Un nombre absent vaut 0.", "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/markSize" }] },
            "r": { "description": "Rectangle. Un nombre absent vaut 0. Un texte nomme un rectangle du terrain.", "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/markRect" }] },
            "c": { "description": "Cercle. Un nombre absent vaut 0. Un texte nomme un cercle du terrain.", "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/markCircle" }] },
            "x": { "type": "number", "description": "Abscisse. Pour une aire, origine de la boîte." },
            "y": { "type": "number", "description": "Ordonnée. Pour une aire, origine de la boîte." },
            "w": { "type": "number", "description": "Largeur, dans l'unité de l'appel. Pour un objet, les traits gardent leur épaisseur et les motifs se répètent. Absente, une formation ou une zone remplit son parent et un objet garde sa taille." },
            "h": { "type": "number", "description": "Hauteur, dans l'unité de l'appel. Pour un objet, les traits gardent leur épaisseur et les motifs se répètent. Absente, une formation ou une zone remplit son parent et un objet garde sa taille." },
            "unit": { "enum": ["meters", "relative"], "description": "Unité de cet appel." },
            "margin": { "description": "Marge extérieure au trait.", "allOf": [{ "$ref": "#/definitions/inset" }] },
            "padding": { "description": "Marge intérieure au trait.", "allOf": [{ "$ref": "#/definitions/inset" }] },
            "angle": { "type": "number", "description": "Angle, en degrés." },
            "min-size": { "description": "Minimum lisible de cet objet, en part du grand côté. 5% ou 0 pour la taille réelle." },
            "real-w": { "type": "number", "description": "Largeur réelle de cette pose, en mètres." },
            "real-h": { "type": "number", "description": "Hauteur réelle de cette pose, en mètres." },
            "fit": { "type": "string", "enum": ["none", "ratio", "free"] },
            "fixed": { "type": "boolean" },
            "upright": { "type": "array", "items": { "type": "string" } },
            "stretch-x": { "type": "string" },
            "stretch-y": { "type": "string" },
            "player": { "type": ["string", "number"], "description": "Joueur qui porte le ballon." },
            "width": { "type": "number", "description": "Largeur du terrain, en mètres." },
            "length": { "type": "number", "description": "Longueur du terrain, en mètres." },
            "boundary": { "type": "string", "description": "Élément posé aux quatre coins." },
            "mirror": { "type": "boolean", "description": "Miroir : les deux extrémités s'échangent." },
            "rotate": { "type": "number", "enum": [180], "description": "Demi-tour autour du centre." },
            "items": { "type": "array", "items": { "$ref": "#/definitions/objectItem" } },
            "shape": { "type": "array", "items": { "$ref": "#/definitions/shapeItem" } },
            "formation": { "type": "array", "items": { "$ref": "#/definitions/formationItem" } },
            "zone": { "type": "array", "items": { "$ref": "#/definitions/zoneItem" } }
          }
        }
      ]
    },
    "objectItem": { "$ref": "#/definitions/item" },
    "shapeItem": { "$ref": "#/definitions/item" },
    "formationItem": { "$ref": "#/definitions/item" },
    "zoneItem": { "$ref": "#/definitions/item" },
    "item": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "description": "La clé est le nom court dans le genre de la liste. Une clé pointée est un identifiant complet.",
      "patternProperties": {
        "^[\\w-]+=[\\w.-]+$": {
          "type": "array",
          "description": "Corps du test. Ces items sont posés quand le paramètre a cette valeur.",
          "items": { "$ref": "#/definitions/item" }
        }
      },
      "additionalProperties": { "$ref": "#/definitions/call" }
    },
    "phase": {
      "type": "object",
      "description": "Phase.",
      "properties": {
        "name": { "type": "string", "description": "Nom." },
        "duration": { "type": "number", "description": "Durée, en secondes." },
        "moves": {
          "type": "array",
          "description": "Déplacements, dans le repère du document.",
          "items": { "$ref": "#/definitions/move" }
        }
      }
    },
    "move": {
      "type": "object",
      "description": "Déplacement ou passe.",
      "properties": {
        "player": { "type": ["string", "number"], "description": "Joueur qui se déplace." },
        "run": { "description": "Course vers un point.", "allOf": [{ "$ref": "#/definitions/travel" }] },
        "dribble": { "description": "Conduite de balle vers un point.", "allOf": [{ "$ref": "#/definitions/travel" }] },
        "from": { "type": ["string", "number"], "description": "Joueur qui passe." },
        "pass": {
          "description": "Joueur qui reçoit, ou point d'arrivée.",
          "oneOf": [
            { "type": "number" },
            { "type": "string" },
            { "$ref": "#/definitions/travel" }
          ]
        }
      }
    }
  }
}
