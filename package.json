		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.0.1",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^2.0.0-next.14",
		"flowbite-svelte-icons": "^3.1.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@milkdown/crepe": "^7.20.0",
		"@milkdown/kit": "^7.20.0",
		"fflate": "^0.8.3",
		"monaco-editor": "^0.54.0",
